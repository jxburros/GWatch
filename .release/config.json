{
  "schemaVersion": 1,
  "bumpPolicy": "every-main-change",
  "apps": {
    "gwatch": {
      "tagPrefix": "v",
      "paths": [
        "VERSION",
        "main.go",
        "main_test.go",
        "migrate_db.go",
        "mcp/**",
        "internal/**",
        "web/**",
        "scripts/installer/gwatch.iss",
        "scripts/install.sh",
        "go.mod",
        "go.sum",
        "cmd/gwatch-sign/**"
      ],
      "versionFiles": [
        {
          "path": "VERSION",
          "format": "text",
          "pattern": "^(?<version>[^\\r\\n]+)$"
        }
      ],
      "notes": ".release/notes/{app}/{version}.md",
      "assets": [
        "gwatch-darwin-amd64",
        "gwatch-darwin-amd64.sha256",
        "gwatch-darwin-amd64.sig",
        "gwatch-darwin-arm64",
        "gwatch-darwin-arm64.sha256",
        "gwatch-darwin-arm64.sig",
        "gwatch-linux-amd64",
        "gwatch-linux-amd64.sha256",
        "gwatch-linux-amd64.sig",
        "gwatch-linux-arm",
        "gwatch-linux-arm.sha256",
        "gwatch-linux-arm.sig",
        "gwatch-linux-arm64",
        "gwatch-linux-arm64.sha256",
        "gwatch-linux-arm64.sig",
        "gwatch-mcp-darwin-amd64",
        "gwatch-mcp-darwin-amd64.sha256",
        "gwatch-mcp-darwin-amd64.sig",
        "gwatch-mcp-darwin-arm64",
        "gwatch-mcp-darwin-arm64.sha256",
        "gwatch-mcp-darwin-arm64.sig",
        "gwatch-mcp-linux-amd64",
        "gwatch-mcp-linux-amd64.sha256",
        "gwatch-mcp-linux-amd64.sig",
        "gwatch-mcp-linux-arm",
        "gwatch-mcp-linux-arm.sha256",
        "gwatch-mcp-linux-arm.sig",
        "gwatch-mcp-linux-arm64",
        "gwatch-mcp-linux-arm64.sha256",
        "gwatch-mcp-linux-arm64.sig",
        "gwatch-mcp-windows-amd64.exe",
        "gwatch-mcp-windows-amd64.exe.sha256",
        "gwatch-mcp-windows-amd64.exe.sig",
        "gwatch-mcp-windows-arm64.exe",
        "gwatch-mcp-windows-arm64.exe.sha256",
        "gwatch-mcp-windows-arm64.exe.sig",
        "gwatch-setup-{version}.exe",
        "gwatch-windows-amd64.exe",
        "gwatch-windows-amd64.exe.sha256",
        "gwatch-windows-amd64.exe.sig",
        "gwatch-windows-arm64.exe",
        "gwatch-windows-arm64.exe.sha256",
        "gwatch-windows-arm64.exe.sig",
        "install.sh"
      ],
      "security": "standard",
      "checksumFile": "SHA256SUMS.txt",
      "legacyLatest": true
    },
    "gwatch-agent": {
      "tagPrefix": "agent-v",
      "paths": [
        "cmd/gwatch-agent/**",
        "internal/**",
        "packaging/**",
        "scripts/installer/gwatch-agent.iss",
        "scripts/install-agent.sh",
        "go.mod",
        "go.sum",
        "cmd/gwatch-sign/**"
      ],
      "versionFiles": [
        {
          "path": "cmd/gwatch-agent/VERSION",
          "format": "text",
          "pattern": "^(?<version>[^\\r\\n]+)$"
        }
      ],
      "notes": ".release/notes/{app}/{version}.md",
      "assets": [
        "gwatch-agent-{version}-1.aarch64.rpm",
        "gwatch-agent-{version}-1.armv7hl.rpm",
        "gwatch-agent-{version}-1.x86_64.rpm",
        "gwatch-agent-darwin-amd64",
        "gwatch-agent-darwin-amd64.sha256",
        "gwatch-agent-darwin-amd64.sig",
        "gwatch-agent-darwin-arm64",
        "gwatch-agent-darwin-arm64.sha256",
        "gwatch-agent-darwin-arm64.sig",
        "gwatch-agent-homebrew-{version}-darwin-amd64.tar.gz",
        "gwatch-agent-homebrew-{version}-darwin-arm64.tar.gz",
        "gwatch-agent-homebrew-{version}-linux-amd64.tar.gz",
        "gwatch-agent-homebrew-{version}-linux-arm64.tar.gz",
        "gwatch-agent-homebrew-{version}.sha256",
        "gwatch-agent-linux-amd64",
        "gwatch-agent-linux-amd64.sha256",
        "gwatch-agent-linux-amd64.sig",
        "gwatch-agent-linux-arm",
        "gwatch-agent-linux-arm.sha256",
        "gwatch-agent-linux-arm.sig",
        "gwatch-agent-linux-arm64",
        "gwatch-agent-linux-arm64.sha256",
        "gwatch-agent-linux-arm64.sig",
        "gwatch-agent-linux-packages-{version}.sha256",
        "gwatch-agent-setup-{version}.exe",
        "gwatch-agent-windows-amd64.exe",
        "gwatch-agent-windows-amd64.exe.sha256",
        "gwatch-agent-windows-amd64.exe.sig",
        "gwatch-agent-windows-arm64.exe",
        "gwatch-agent-windows-arm64.exe.sha256",
        "gwatch-agent-windows-arm64.exe.sig",
        "gwatch-agent-winget-manifests-{version}.zip",
        "gwatch-agent-winget-setup-{version}.exe",
        "gwatch-agent_{version}-1_amd64.deb",
        "gwatch-agent_{version}-1_arm64.deb",
        "gwatch-agent_{version}-1_armhf.deb",
        "install-agent.sh"
      ],
      "security": "standard",
      "checksumFile": "SHA256SUMS.txt"
    }
  }
}
