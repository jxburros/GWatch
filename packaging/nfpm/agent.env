# Environment for the gwatch-agent service (/usr/lib/systemd/system/gwatch-agent.service).
#
# Nothing here is needed if this machine was set up with
#
#   sudo gwatch-agent pair --server https://gwatch.lan:7230 --code XXXX-XXXX
#
# which keeps the token and the server address in /var/lib/gwatch-agent and
# starts the service. This file is for setting a machine up from a script with
# a token instead of a code (GWatch: Settings > Hardware > Register a machine),
# or for changing how often it reports. Anything set here wins over what
# pairing stored. After editing: sudo systemctl restart gwatch-agent
#
# It is readable only by root because a token may be in it. The token can do
# exactly one thing — submit this machine's readings — but there is no reason
# to leave it where anyone can read it.

#GWATCH_SERVER=https://gwatch.lan:7230
#GWATCH_AGENT_TOKEN=gwa_...
#GWATCH_AGENT_INTERVAL=60s

# Automatic updates are not a setting here: this agent was installed from a
# package, so the package manager keeps it up to date and the agent never
# replaces its own binary, whatever GWATCH_AGENT_AUTO_UPDATE says.
