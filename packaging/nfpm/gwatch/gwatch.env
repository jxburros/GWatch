# Environment for the GWatch service (/usr/lib/systemd/system/gwatch.service).
#
# Nothing here is needed: installed from this package, GWatch keeps its data
# in /var/lib/gwatch and serves the web interface on http://127.0.0.1:7230,
# this machine only. Anything set here wins over those defaults.
# After editing: sudo systemctl restart gwatch
#
# It is readable only by root because it may hold a database password.

# The address the service starts on. 0.0.0.0:7230 serves the whole network;
# Settings > Network can also change the port while it runs.
#GWATCH_LISTEN=0.0.0.0:7230

# A PostgreSQL or MySQL database instead of SQLite (docs/DATABASE.md).
# Settings > Database keeps the same settings in /var/lib/gwatch/database.json.
#GWATCH_DB_DRIVER=postgres
#GWATCH_DB_HOST=localhost
#GWATCH_DB_USER=gwatch
#GWATCH_DB_PASSWORD=
#GWATCH_DB_NAME=gwatch

# GWATCH_DATA_DIR can move the data, but the service may write only to
# /var/lib/gwatch: a directory anywhere else also needs ReadWritePaths= in a
# drop-in (sudo systemctl edit gwatch) and has to belong to the gwatch user.
#GWATCH_DATA_DIR=/var/lib/gwatch

# Updates are not a setting here: this copy was installed from a package, so
# the package manager keeps it up to date and GWatch never replaces its own
# executable.
